# === 비밀값 파일 (환경 변수, 키 등 민감 정보) ===
# 기본 환경 변수 파일 (비밀값 포함 가능)
.env
# .env.local, .env.production 등 환경별 변수 파일
.env.*
# 개인 키/인증서 파일
*.pem
# 비밀 키 파일
*.key

# === 개인정보가 든 원자료 ===
# 개인정보가 포함될 수 있는 원본 데이터 폴더 전체 제외
raw/

# === OS가 자동으로 만드는 파일 ===
# macOS 폴더 정보 캐시 파일
.DS_Store
# Windows 썸네일 캐시 파일
Thumbs.db

# === 한글(HWP/HWPX) 및 오피스 임시 파일 ===
# 한글 프로그램이 만드는 임시 파일
~$*.hwp
# 한글(HWPX) 임시 파일
~$*.hwpx
# 워드 임시 파일
~$*.doc
# 워드(docx) 임시 파일
~$*.docx
# 엑셀 임시 파일
~$*.xls
# 엑셀(xlsx) 임시 파일
~$*.xlsx
# 파워포인트 임시 파일
~$*.ppt
# 파워포인트(pptx) 임시 파일
~$*.pptx
# 리브레오피스 계열 잠금 임시 파일
.~lock.*#

# === PDF 파일 ===
# 모든 PDF 파일 제외
*.pdf

# === Claude Code 로컬 설정 (개인 환경별 설정, 공유 불필요) ===
# 개인 로컬 전용 설정 파일
.claude/settings.local.json
